# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rental_db

# Authentication
AUTHENTICATION_SECRET=your_secret_here

# S3 / Cloudflare R2 Storage
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=auto
S3_ENDPOINT=https://your_r2_endpoint.cloudflarestorage.com
S3_BUCKET_NAME=YOUR_PUBLIC_BUCKET_NAME

# Public CDN Configuration
NEXT_PUBLIC_CDN_URL=https://pub-your_id.r2.dev

# App URL (For links in emails/PDFs)
NEXT_PUBLIC_APP_URL=https://e3catalog.vercel.app

# Email Configuration (Resend)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="E3 Rentals <noreply@YOUR_VERIFIED_DOMAIN.com>"
