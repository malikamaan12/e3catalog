# ==============================================================================
# E3 Rentals Qatar — Production Environment Variables Template
# Copy this file to .env.production on the host before launching the stack.
# DO NOT COMMIT LIVE SECRETS TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Base Public URLs (Must match production domain and HTTPS)
NEXT_PUBLIC_APP_URL=https://rentals.e3qatar.com
NEXT_PUBLIC_BASE_URL=https://rentals.e3qatar.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# For self-hosted Docker container (default in docker-compose.prod.yml):
POSTGRES_USER=e3admin
POSTGRES_PASSWORD=replace_with_strong_database_password_min_32_chars
POSTGRES_DB=e3_rentals_prod

# Connection URL:
# Container-to-container network string:
DATABASE_URL=postgresql://e3admin:replace_with_strong_database_password_min_32_chars@postgres:5432/e3_rentals_prod?sslmode=disable
# Or if using managed Supabase / AWS RDS / DigitalOcean Managed DB:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-me-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. REDIS & CACHE CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password_min_32_chars
REDIS_URL=redis://:replace_with_strong_redis_password_min_32_chars@redis:6379

# Or Upstash Redis (Serverless alternative):
# RATE_LIMIT_DRIVER=redis
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTHENTICATION_SECRET=replace_with_openssl_rand_base64_32_production_secret
JWT_SECRET=replace_with_openssl_rand_base64_32_production_secret
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32_production_secret
NEXTAUTH_URL=https://rentals.e3qatar.com

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
# Set to 's3' for production S3/R2 storage, or 'disabled' if using external CDN
STORAGE_DRIVER=s3
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=e3-rentals-public
S3_PRIVATE_BUCKET_NAME=e3-rentals-private
S3_ACCESS_KEY_ID=your_s3_access_key_id_here
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
NEXT_PUBLIC_CDN_URL=https://assets.e3qatar.com

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Resend / SMTP)
# ------------------------------------------------------------------------------
EMAIL_DRIVER=resend
RESEND_API_KEY=re_your_api_key_placeholder
EMAIL_FROM=E3 Rentals Qatar <noreply@rentals.e3qatar.com>
SUPPORT_EMAIL=support@rentals.e3qatar.com

# Or SMTP alternative:
# EMAIL_DRIVER=smtp
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@rentals.e3qatar.com
# SMTP_PASS=your_smtp_password_here

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (Qatar Sadad / Stripe)
# ------------------------------------------------------------------------------
# For Qatar National Gateways:
PAYMENT_DRIVER=sadad
SADAD_MERCHANT_ID=your_sadad_merchant_id_here
SADAD_SECRET_KEY=your_sadad_secret_key_here

# Or Stripe alternative:
# PAYMENT_DRIVER=stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# STRIPE_SECRET_KEY=sk_test_placeholder_key_not_live
# STRIPE_WEBHOOK_SECRET=whsec_test_placeholder_secret

# ------------------------------------------------------------------------------
# 8. WHATSAPP CLOUD API & SMS (Qatar Operations)
# ------------------------------------------------------------------------------
WHATSAPP_SANDBOX_MODE=false
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_API_TOKEN=your_whatsapp_meta_cloud_api_token_here

# ------------------------------------------------------------------------------
# 9. OPERATIONS, HEALTHCHECKS & CRON HOOKS
# ------------------------------------------------------------------------------
# Secret tokens used by cloud scheduler to trigger recurring cron routes
CRON_SECRET=replace_with_openssl_rand_base64_32_cron_secret
OPS_SECRET=replace_with_openssl_rand_base64_32_ops_secret
